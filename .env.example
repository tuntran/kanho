# ── App ──────────────────────────────────────────────
APP_PORT=8080
KANHO_JWT_SECRET=change-me-in-production

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_USER=kanho
POSTGRES_PASSWORD=kanho
POSTGRES_DB=kanho

# ── MinIO ─────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Public domain for presigned URL generation (set in production)
# Example: MINIO_SERVER_URL=https://storage.yourdomain.com
MINIO_SERVER_URL=

# ── Storage (app) ─────────────────────────────────────
KANHO_STORAGE_BUCKET=kanho
KANHO_STORAGE_PUBLIC_URL=http://localhost:9000/kanho
